# =========================================================================
# Village Setu — LOCAL OFFLINE version — .env.example
# =========================================================================
# This file is a template. The setup.sh script generates a real .env
# automatically with random JWT_SECRET and ENCRYPTION_KEY on first run.
#
# You can also edit .env manually after setup to customize values.
# -------------------------------------------------------------------------

# --- Database (LOCAL SQLite by default) ----------------------------------
# SQLite file database — no internet, no cloud, no setup needed.
# The database file (village_setu.db) is created automatically on first run.
DATABASE_URL=sqlite:///./village_setu.db

# (Optional) If you want PostgreSQL or MySQL instead, uncomment and set:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:port/dbname
# DATABASE_URL=mysql+pymysql://user:pass@host:port/dbname

# --- Auth / JWT ----------------------------------------------------------
# Auto-generated by setup.sh. You can replace with your own.
JWT_SECRET=auto-generated-by-setup-script
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Bootstrap admin -----------------------------------------------------
# These credentials create the first admin user on first run.
ADMIN_EMAIL=admin@villagesetu.gov.in
ADMIN_PASSWORD=Admin@12345

# --- File uploads --------------------------------------------------------
# Files stored locally in this folder.
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=5

# --- Aadhaar encryption key (auto-generated by setup.sh) ----------------
ENCRYPTION_KEY=auto-generated-by-setup-script

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=*

# --- App meta ------------------------------------------------------------
APP_NAME=Village Setu
APP_ENV=local
